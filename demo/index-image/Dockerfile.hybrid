FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /seed
COPY seed_hybrid.py ./
COPY --from=serving_bundle /manifest.json /bm25.sqlite /payload/
COPY --from=serving_bundle /vectors/ /payload/vectors/
COPY --from=serving_bundle /query/ /payload/query/
RUN python seed_hybrid.py --verify-source
ENTRYPOINT ["python", "/seed/seed_hybrid.py"]
